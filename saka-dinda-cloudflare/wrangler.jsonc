{
  "name": "putrasaka-stiadinda-wedding",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saka-dinda-guestbook",
      "database_id": "c7a320ee-caf5-4f96-8d4b-de3b1cd1341d",
      "migrations_dir": "migrations"
    }
  ]
}
