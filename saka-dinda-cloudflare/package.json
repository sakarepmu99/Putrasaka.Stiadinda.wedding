    "lucide-react": "1.31.0",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "vite": "8.0.13",
    "@vitejs/plugin-react": "6.0.2",
    "wrangler": "4.92.0",
    "typescript": "5.9.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.19",
    "@cloudflare/workers-types": "4.20260515.1"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "Database RSVP dan buku ucapan Saka & Dinda. Dibuat otomatis saat deploy."
